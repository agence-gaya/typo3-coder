{
  "name": "gaya/typo3-coder",
  "description": "Checks TYPO3 code against multiple tools.",
  "type": "composer-plugin",
  "license": "GPL-2.0-or-later",
  "version": "14.2.2",
  "require": {
    "php": "^8.2",
    "composer-plugin-api": "^2.0",
    "typo3/cms-core": "^14.0",
    "ssch/typo3-rector": "^3.12",
    "typo3/testing-framework": "^9.3",
    "friendsofphp/php-cs-fixer": "^3.94",
    "a9f/typo3-fractor": "^1.1",
    "overtrue/phplint": "^9.7",
    "helmich/typo3-typoscript-lint": "^3.3",
    "symfony/yaml": "^7.4 || ^8.0",
    "saschaegerer/phpstan-typo3": "^3.1"
  },
  "require-dev": {
    "composer/composer": "^2.5",
    "phpunit/phpunit": "^11.5 || ^12.1 || ^13.0"
  },
  "extra": {
    "class": "GAYA\\Typo3Coder\\Composer\\Installer\\Plugin",
    "gaya/typo3-coder": {
      "paths": ["src", "Tests"],
      "tests": {
        "unit": ["Tests"]
      }
    }
  },
  "scripts": {
    "coder:rector": "GAYA\\Typo3Coder\\Composer\\Command\\RectorCommand",
    "coder:fractor": "GAYA\\Typo3Coder\\Composer\\Command\\FractorCommand",
    "coder:php-cs-fixer": "GAYA\\Typo3Coder\\Composer\\Command\\PhpCsFixerCommand",
    "coder:phplint": "GAYA\\Typo3Coder\\Composer\\Command\\PhpLintCommand",
    "coder:yaml-lint": "GAYA\\Typo3Coder\\Composer\\Command\\YamlLintCommand",
    "coder:phpstan": "GAYA\\Typo3Coder\\Composer\\Command\\PhpstanCommand",
    "coder:phpstan:baseline": "GAYA\\Typo3Coder\\Composer\\Command\\PhpstanBaselineCommand",
    "coder:tests:unit": "GAYA\\Typo3Coder\\Composer\\Command\\UnitTestsCommand",
    "coder:tests:functional": "GAYA\\Typo3Coder\\Composer\\Command\\FunctionalTestsCommand",
    "coder:all": "GAYA\\Typo3Coder\\Composer\\Command\\AllCommand"
  },
  "autoload": {
    "psr-4": {
      "GAYA\\Typo3Coder\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "a9f/fractor-extension-installer": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GAYA\\Typo3Coder\\Tests\\": "Tests/"
    }
  }
}
