{
  "name": "gaya/typo3-coder",
  "description": "Checks TYPO3 code against multiple tools.",
  "type": "composer-plugin",
  "license": "GPL-2.0-or-later",
  "version": "13.0.4",
  "require": {
    "composer-plugin-api": "^2.0",
    "typo3/cms-core": "^13.4",
    "ssch/typo3-rector": "^3.6",
    "typo3/testing-framework": "^9.2",
    "friendsofphp/php-cs-fixer": "^3.85",
    "a9f/typo3-fractor": "0.5.3",
    "a9f/fractor": "0.5.3",
    "overtrue/phplint": "^9.6"
  },
  "require-dev": {
    "composer/composer": "^2.0"
  },
  "extra": {
    "class": "GAYA\\Typo3Coder\\Composer\\Installer\\Plugin"
  },
  "autoload": {
    "psr-4": {
      "GAYA\\Typo3Coder\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "a9f/fractor-extension-installer": true
    }
  }
}
